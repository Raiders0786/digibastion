
{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://vercel.live https://*.vercel-insights.com https://*.vercel-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.web3forms.com https://unavatar.io https://*.vercel-insights.com https://*.vercel-analytics.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://api.web3forms.com; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/news", "destination": "/threat-intel", "permanent": true },
    { "source": "/present", "destination": "/about", "permanent": true },
    { "source": "/articles/web3-wallet-security-guide", "destination": "/articles/getting-started-web3-security", "permanent": true },
    { "source": "/articles/defi-security-best-practices", "destination": "/articles/defi-smart-contract-audit-checklist", "permanent": true },
    { "source": "/articles/nft-security-guide", "destination": "/articles/nft-marketplace-security", "permanent": true }
  ],
  "rewrites": [
    { 
      "source": "/quiz-result",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(twitterbot|facebookexternalhit|linkedinbot|slackbot|discordbot|telegrambot|whatsapp).*"
        }
      ],
      "destination": "/api/og-tags"
    },
    { "source": "/(.*)", "destination": "/" }
  ]
}
